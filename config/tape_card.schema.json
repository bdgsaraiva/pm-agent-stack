{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pmstack/tape_card/v1",
  "title": "Tape card",
  "description": "What the quant agent (agent 13) writes after the close from briefs/<date>/quant.json: what is stretched, what flipped, what changed against vol. Text cites [sN] ids from the tape's numbered sources; every number must be one of them (pmstack.cards). Descriptive only: no signals, no trade instructions.",
  "type": "object",
  "required": ["schema", "as_of", "author", "headline", "flipped", "stretched", "vol", "watch", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "enum": ["tape_card/v1"]},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "author": {"type": "string"},
    "headline": {"type": "string", "minLength": 1, "description": "one sentence: the most important change in the tape"},
    "flipped": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 8},
    "stretched": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 8},
    "vol": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 6},
    "correlation": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 4},
    "positioning": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 4},
    "curve": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 4},
    "seasonal": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 3},
    "watch": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 0, "maxItems": 5,
              "description": "may be empty on a quiet day; levels to watch overnight (flip levels within 1 sd, roll-off flips), as pack figures"},
    "inference": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "label", "url"], "additionalProperties": false,
      "properties": {"id": {"type": "string", "pattern": "^s\\d+$"}, "label": {"type": "string"},
                     "value": {"type": ["number", "string", "null"]}, "unit": {"type": ["string", "null"]},
                     "date": {"type": ["string", "null"]}, "url": {"type": "string"}, "from": {"type": "string"}}}}
  }
}
